---
import Layout from '../layouts/Layout.astro';
import screenshot from '../assets/screenshot.png';

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>`,
    title: 'All your feeds, one place',
    description: 'Subscribe to any RSS or Atom feed. Feedwire keeps everything organised and in sync.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Instant updates',
    description: 'Background refresh keeps your feeds current without interrupting your workflow.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Built for Mac',
    description: 'A native macOS experience with keyboard shortcuts, notifications, and a clean UI that feels right at home.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8"/><path d="M3 16.2V21m0 0h4.8M3 21l6-6"/><path d="M21 7.8V3m0 0h-4.8M21 3l-6 6"/><path d="M3 7.8V3m0 0h4.8M3 3l6 6"/></svg>`,
    title: 'Distraction-free reading',
    description: 'Reader mode strips away noise so you can focus on the content that matters to you.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: 'Save what you love',
    description: 'Star articles, organise them into collections, and come back whenever you want.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Private by default',
    description: 'No account required. Your feeds and reading history stay on your device.',
  },
];
---

<Layout>
  <!-- Nav -->
  <header style="background: var(--bg-nav); border-bottom: 1px solid var(--border-nav);"
          class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <div class="flex items-center gap-2">
        <div class="h-6 w-6 rounded-[6px] flex items-center justify-center" style="background: #0A84FF;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1"/>
          </svg>
        </div>
        <span class="text-sm font-semibold tracking-tight" style="color: var(--text-nav);">Feedwire</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class="flex h-8 w-8 items-center justify-center rounded-lg transition"
          style="color: var(--text-muted); background: var(--bg-surface); border: 1px solid var(--border);"
        >
          <!-- Sun (shown in dark mode) -->
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <!-- Moon (shown in light mode) -->
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <a
          href="#download"
          class="rounded-lg px-4 py-1.5 text-sm font-semibold transition"
          style="background: var(--btn-bg); color: var(--btn-text);"
          onmouseover="this.style.background='var(--btn-hover)'"
          onmouseout="this.style.background='var(--btn-bg)'"
        >
          Download
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative flex min-h-screen flex-col items-center justify-center px-6 pt-[300px] pb-20 text-center overflow-hidden">
      <!-- Background glow -->
      <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
        <div class="h-[600px] w-[600px] rounded-full blur-[120px]" style="background: var(--glow);"></div>
      </div>

      <h1 class="relative max-w-3xl text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
          style="color: var(--text-primary);">
        Read what matters.<br />
        <span style="color: #0A84FF;">Nothing else.</span>
      </h1>

      <p class="relative mt-6 max-w-xl text-lg leading-relaxed" style="color: var(--text-secondary);">
        Feedwire is a native macOS feed reader that keeps you in the loop — fast, focused, and free of noise.
      </p>

      <!-- CTA -->
      <div id="download" class="relative mt-10 flex flex-col items-center gap-3 sm:flex-row sm:gap-4">
        <a
          href="/feedwire.dmg"
          class="group flex items-center gap-2.5 rounded-xl px-6 py-3 text-sm font-semibold transition active:scale-95"
          style="background: var(--btn-bg); color: var(--btn-text);"
          onmouseover="this.style.background='var(--btn-hover)'"
          onmouseout="this.style.background='var(--btn-bg)'"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 17V3"/>
            <path d="m6 11 6 6 6-6"/>
            <path d="M19 21H5"/>
          </svg>
          Download for Mac
        </a>
        <span class="text-xs" style="color: var(--text-faint);">macOS 13 Ventura or later</span>
      </div>

      <!-- App screenshot placeholder -->
      <div class="relative mt-20 w-full max-w-4xl">
        <div class="relative overflow-hidden rounded-2xl shadow-2xl"
             style="border: 1px solid var(--screenshot-border); background: var(--bg-surface); box-shadow: 0 25px 60px var(--shadow);">
          <!-- Window chrome -->
          <div class="flex items-center gap-1.5 px-4 py-3"
               style="border-bottom: 1px solid var(--screenshot-chrome);">
            <div class="h-3 w-3 rounded-full bg-[#ff5f57]"></div>
            <div class="h-3 w-3 rounded-full bg-[#febc2e]"></div>
            <div class="h-3 w-3 rounded-full bg-[#28c840]"></div>
          </div>
          <!-- Screenshot area -->
          <div class="flex items-center justify-center"
               style="background: var(--screenshot-bg);">
            <img src={screenshot.src} alt="Feedwire app screenshot" class="w-full block" />
          </div>
        </div>
        <!-- Glow under the window -->
        <div class="pointer-events-none absolute -bottom-10 left-1/2 h-40 w-3/4 -translate-x-1/2 rounded-full blur-3xl"
             style="background: var(--glow-strong);"></div>
      </div>
    </section>

    <!-- Features -->
    <section class="mx-auto max-w-5xl px-6 py-24">
      <div class="mb-14 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text-primary);">
          Everything you need to stay informed
        </h2>
        <p class="mt-4" style="color: var(--text-muted);">
          Designed for people who care about signal, not noise.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <div class="group rounded-2xl p-6 transition feature-card"
               style="border: 1px solid var(--border); background: var(--bg-surface);">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl"
                 style="border: 1px solid var(--border-icon); background: var(--bg-icon); color: #0A84FF;">
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="mb-2 text-sm font-semibold" style="color: var(--text-primary);">{feature.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing -->
    <section class="mx-auto max-w-5xl px-6 py-24">
      <div class="mb-14 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text-primary);">
          Simple, honest pricing
        </h2>
        <p class="mt-4" style="color: var(--text-muted);">
          Start for free. Upgrade once when you're ready.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 max-w-2xl mx-auto">

        <!-- Free tier -->
        <div class="rounded-2xl p-8 flex flex-col"
             style="border: 1px solid var(--border); background: var(--bg-surface);">
          <div class="mb-6">
            <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--text-muted);">Free</p>
            <div class="flex items-end gap-1">
              <span class="text-4xl font-bold" style="color: var(--text-primary);">$0</span>
            </div>
            <p class="mt-2 text-sm" style="color: var(--text-muted);">Free forever. No credit card needed.</p>
          </div>

          <ul class="space-y-3 mb-8 flex-1">
            {[
              'Up to X feeds',               /* TODO: set feed limit */
              'Basic article reader',
              'Manual refresh',
              'Starred articles',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm" style="color: var(--text-secondary);">
                <svg class="mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0A84FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>

          <a
            href="/feedwire.dmg"
            class="block w-full rounded-xl py-2.5 text-center text-sm font-semibold transition"
            style="border: 1px solid var(--border-hover); color: var(--text-primary); background: var(--bg-surface-hover);"
          >
            Download free
          </a>
        </div>

        <!-- Pro tier -->
        <div class="rounded-2xl p-8 flex flex-col relative overflow-hidden"
             style="border: 1px solid #0A84FF44; background: var(--bg-surface);">
          <!-- Subtle blue glow top-right -->
          <div class="pointer-events-none absolute -top-12 -right-12 h-40 w-40 rounded-full blur-3xl" style="background: rgba(10,132,255,0.12);"></div>

          <div class="mb-6 relative">
            <div class="flex items-center gap-2 mb-3">
              <p class="text-xs font-semibold uppercase tracking-widest" style="color: #0A84FF;">Pro</p>
              <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold" style="background: rgba(10,132,255,0.12); color: #0A84FF;">Coming soon</span>
            </div>
            <div class="flex items-end gap-1">
              <span class="text-4xl font-bold" style="color: var(--text-primary);">$XX</span> <!-- TODO: set price -->
              <span class="mb-1 text-sm" style="color: var(--text-muted);">one-time</span>
            </div>
            <p class="mt-2 text-sm" style="color: var(--text-muted);">Pay once, own it forever.</p>
          </div>

          <ul class="space-y-3 mb-8 flex-1 relative">
            {[
              'Unlimited feeds',
              'Background auto-refresh',
              'Full reader mode',
              'Collections & folders',
              'iCloud sync',              /* TODO: confirm if planned */
              'Priority support',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm" style="color: var(--text-secondary);">
                <svg class="mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0A84FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>

          <button
            disabled
            class="relative block w-full rounded-xl py-2.5 text-center text-sm font-semibold cursor-not-allowed"
            style="background: #0A84FF; color: #fff; opacity: 0.5;"
          >
            Coming soon
          </button>
        </div>

      </div>
    </section>

    <!-- CTA bottom -->
    <section class="mx-auto max-w-5xl px-6 pb-32">
      <div class="relative overflow-hidden rounded-3xl px-8 py-16 text-center"
           style="border: 1px solid var(--border); background: var(--bg-surface);">
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <div class="h-64 w-64 rounded-full blur-3xl" style="background: var(--glow);"></div>
        </div>
        <h2 class="relative text-3xl font-bold tracking-tight" style="color: var(--text-primary);">
          Start reading smarter.
        </h2>
        <p class="relative mt-3" style="color: var(--text-muted);">
          Free to download. Upgrade to Pro whenever you're ready.
        </p>
        <a
          href="/feedwire.dmg"
          class="relative mt-8 inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition active:scale-95"
          style="background: var(--btn-bg); color: var(--btn-text);"
          onmouseover="this.style.background='var(--btn-hover)'"
          onmouseout="this.style.background='var(--btn-bg)'"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 17V3"/>
            <path d="m6 11 6 6 6-6"/>
            <path d="M19 21H5"/>
          </svg>
          Download for Mac
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="px-6 py-8" style="border-top: 1px solid var(--border-nav);">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 text-xs sm:flex-row"
         style="color: var(--text-faint);">
      <div class="flex items-center gap-2">
        <div class="h-4 w-4 rounded-[4px] flex items-center justify-center" style="background: #0A84FF;">
          <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1"/>
          </svg>
        </div>
        <span>Feedwire</span>
      </div>
      <span>© {new Date().getFullYear()} Feedwire. All rights reserved.</span>
    </div>
  </footer>
</Layout>

<style>
  .feature-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface-hover);
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const sun = document.getElementById('icon-sun')!;
  const moon = document.getElementById('icon-moon')!;

  // Resolve initial theme: saved preference → OS preference → dark
  const saved = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  let isDark = saved ? saved === 'dark' : prefersDark;

  function apply(dark: boolean) {
    root.setAttribute('data-theme', dark ? 'dark' : 'light');
    sun.classList.toggle('hidden', !dark);
    moon.classList.toggle('hidden', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  }

  apply(isDark);

  btn.addEventListener('click', () => {
    isDark = !isDark;
    apply(isDark);
  });
</script>
