---
import Layout from '../layouts/Layout.astro';
import screenshot from '../assets/screenshot.png';
import screenshotLight from '../assets/screenshot-light.png';
import logo from '../assets/logo.png';

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>`,
    title: 'All your feeds, one place',
    description: 'Subscribe to RSS or Atom feeds. Feedwire keeps everything organised and in sync, so you never miss what matters.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Instant updates',
    description: 'Background auto-refresh keeps your feeds current without interrupting your workflow. New articles are there when you look.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>`,
    title: 'YouTube as a feed',
    description: 'Subscribe to any YouTube channel and get new videos alongside your other feeds — no algorithm, no recommendations, just the channels you chose. Shorts can be hidden with a single toggle.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>`,
    title: 'Organize with folders',
    description: 'Group feeds into folders to keep things tidy. News, tech, YouTube — whatever makes sense to you.',
    pro: true,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Bookmarks',
    description: 'Save articles with a click and find them again later. Simple bookmarking, nothing more.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>`,
    title: 'Filter by URL rules',
    description: 'Write your own URL patterns to hide unwanted entries from any feed. Block specific sections, topics, or domains without touching the source.',
    pro: true,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Private by default',
    description: 'No account required. Your feeds and reading history stay on your device. Nothing is sent to a server.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Small and native',
    description: 'Built with Rust and Tauri. A tiny download that launches instantly and stays out of the way.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/><polyline points="21 4 21 10 15 10"/></svg>`,
    title: 'More coming soon',
    description: 'Feedwire is actively developed. New features and improvements ship regularly — this is just the beginning.',
  },
];
---

<Layout>
  <!-- Nav -->
  <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md"
          style="background: var(--bg-nav); border-bottom: 1px solid var(--border-nav);">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <div class="flex items-center gap-2">
        <img src={logo.src} class="h-6 w-6" alt="Feedwire logo">
        <span class="text-sm font-semibold tracking-tight" style="color: var(--text-nav);">Feedwire</span>
      </div>
      <div class="flex items-center gap-6">
        <nav class="hidden sm:flex items-center gap-6 text-sm" style="color: var(--text-muted);">
          <a href="#features" class="hover:opacity-80 transition" style="color: var(--text-secondary);">Features</a>
          <a href="#pricing" class="hover:opacity-80 transition" style="color: var(--text-secondary);">Pricing</a>
        </nav>
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class="flex h-8 w-8 items-center justify-center rounded-lg transition"
          style="color: var(--text-muted); background: var(--bg-surface); border: 1px solid var(--border);"
        >
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
        <a
          href="#download"
          class="rounded-lg px-4 py-1.5 text-sm font-semibold transition"
          style="background: var(--btn-bg); color: var(--btn-text);"
          onmouseover="this.style.background='var(--btn-hover)'"
          onmouseout="this.style.background='var(--btn-bg)'"
        >
          Download
        </a>
      </div>
    </div>
  </header>

  <!--
    The page-frame div draws the two vertical side borders that run the full
    page height. It is constrained to max-w-5xl and centered, same as the nav,
    so the lines line up with the nav border edges exactly.
    All sections live inside it and get left/right padding via .inner.
  -->
  <div class="page-frame">
    <main>

      <!-- Hero -->
      <section class="inner pt-[200px] pb-32 text-center">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
            style="color: var(--text-primary); line-height: 1.15;">
          A simple feed reader for macOS.
        </h1>
        <p class="mt-5 text-base leading-relaxed mx-auto max-w-lg" style="color: var(--text-secondary);">
          Follow RSS, Atom, and YouTube channels in one place. No accounts, no tracking — just your feeds, kept up to date.
        </p>
        <div id="download" class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="https://github.com/jeksn/feedwire/releases"
            class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition active:scale-95"
            style="background: var(--btn-bg); color: var(--btn-text);"
            onmouseover="this.style.background='var(--btn-hover)'"
            onmouseout="this.style.background='var(--btn-bg)'"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/>
            </svg>
            Download for Mac
          </a>
          <span class="text-xs" style="color: var(--text-faint);">macOS 13 Ventura or later</span>
        </div>
      </section>

      <!-- Screenshot -->
      <div class="section-divider">
        <div class="overflow-hidden m-3" style="border: 1px solid var(--border); border-bottom: none;">
          <div class="flex items-center gap-1.5 px-3 py-2.5" style="border-bottom: 1px solid var(--border); background: var(--bg-surface);">
            <div class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></div>
          </div>
          <img src={screenshot.src} alt="Feedwire app screenshot" class="screenshot-dark w-full block" />
          <img src={screenshotLight.src} alt="Feedwire app screenshot" class="screenshot-light w-full block" />
        </div>
      </div>

      <!-- Features -->
      <section class="section-divider" id="features">
        <div class="inner py-12">
          <h2 class="section-label">Features</h2>
        </div>
        <div class="features-grid">
          {features.map((feature) => (
            <div class="feature-cell inner py-8">
              <div class="mb-3" style="color: #0A84FF;">
                <Fragment set:html={feature.icon} />
              </div>
              <div class="flex items-center gap-2 mb-1.5">
                <h3 class="text-sm font-semibold" style="color: var(--text-primary);">{feature.title}</h3>
                {feature.pro && (
                  <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold" style="background: var(--bg-surface); border: 1px solid var(--border); color: #0A84FF;">Pro · free during beta</span>
                )}
              </div>
              <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{feature.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Pricing -->
      <section class="section-divider" id="pricing">
        <div class="inner py-12">
          <h2 class="section-label">Pricing</h2>
        </div>

        <!-- Beta banner -->
        <div class="inner py-10" style="border-bottom: 1px solid var(--border);">
          <div class="flex items-center gap-2 mb-2">
            <span class="rounded px-2 py-0.5 text-[11px] font-semibold" style="background: rgba(10,132,255,0.12); color: #0A84FF;">Beta</span>
            <h3 class="text-base font-semibold" style="color: var(--text-primary);">Free during beta</h3>
          </div>
          <p class="text-sm max-w-md" style="color: var(--text-muted);">
            Feedwire is free to use during beta, with all features unlocked. A paid Pro tier will be introduced later — early users will be taken care of.
          </p>
        </div>

        <!-- Future tiers preview (faded — not yet in effect) -->
        <div class="pricing-grid" style="opacity: 0.5;">

          <!-- Free -->
          <div class="inner py-8 flex flex-col" style="border-right: 1px solid var(--border);">
            <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: var(--text-muted);">Free</p>
            <p class="text-sm mb-7" style="color: var(--text-muted);">Free forever. No credit card needed.</p>
            <ul class="space-y-2.5 mb-8 flex-1">
              {[
                'Up to 25 feeds',
                'Bookmarks',
                'Manual refresh',
              ].map(item => (
                <li class="flex items-center gap-2.5 text-sm" style="color: var(--text-secondary);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0A84FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-xs" style="color: var(--text-faint);">Available after beta</p>
          </div>

          <!-- Pro -->
          <div class="inner py-8 flex flex-col">
            <div class="flex items-center gap-2 mb-4">
              <p class="text-xs font-semibold uppercase tracking-widest" style="color: #0A84FF;">Pro</p>
              <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold" style="background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-muted);">Planned</span>
            </div>
            <p class="text-sm mb-7" style="color: var(--text-muted);">One-time purchase. Pay once, own it forever.</p>
            <ul class="space-y-2.5 mb-8 flex-1">
              {[
                'Unlimited feeds',
                'Background auto-refresh',
                'Folders',
                'Filter by URL rules',
                'Priority support',
              ].map(item => (
                <li class="flex items-center gap-2.5 text-sm" style="color: var(--text-faint);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-xs" style="color: var(--text-faint);">Coming after beta</p>
          </div>

        </div>
      </section>

      <!-- Bottom CTA -->
      <section class="section-divider">
        <div class="inner py-14 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div>
            <h2 class="text-lg font-semibold" style="color: var(--text-primary);">Try Feedwire during beta.</h2>
            <p class="mt-1 text-sm" style="color: var(--text-muted);">Free to use now. Pro features coming later.</p>
          </div>
          <a
            href="https://github.com/jeksn/feedwire/releases"
            class="shrink-0 inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition active:scale-95"
            style="background: var(--btn-bg); color: var(--btn-text);"
            onmouseover="this.style.background='var(--btn-hover)'"
            onmouseout="this.style.background='var(--btn-bg)'"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/>
            </svg>
            Download for Mac
          </a>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="section-divider">
      <div class="inner py-7 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs" style="color: var(--text-faint);">
        <div class="flex items-center gap-2">
          <img src={logo.src} class="size-4" alt="Feedwire logo">
          <span>Feedwire</span>
        </div>
        <span>© {new Date().getFullYear()} Feedwire. All rights reserved.</span>
      </div>
    </footer>
  </div>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem; /* offset for fixed nav */
  }

  /* ── Page frame: centered column with persistent side borders ── */
  .page-frame {
    max-width: 64rem; /* max-w-5xl = 1024px */
    margin-inline: auto;
    border-left: 1px solid var(--border-nav);
    border-right: 1px solid var(--border-nav);
    min-height: 100vh;
  }

  /* Horizontal divider between every section */
  .section-divider {
    border-top: 1px solid var(--border);
  }

  /* Inner padding — matches nav px-6 */
  .inner {
    padding-inline: 1.5rem;
  }

  /* Section label */
  .section-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  /* ── Features grid ── */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--border);
  }

  .feature-cell {
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
    /* right border on odd cells (left column) */
    .feature-cell:nth-child(odd) {
      border-right: 1px solid var(--border);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    /* restore: only first and second column get right border */
    .feature-cell:nth-child(odd) {
      border-right: none;
    }
    .feature-cell:nth-child(3n+1),
    .feature-cell:nth-child(3n+2) {
      border-right: 1px solid var(--border);
    }
  }

  .feature-cell:hover {
    background: var(--bg-surface);
  }

  /* ── Pricing grid ── */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .pricing-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Screenshots ── */
  .screenshot-light { display: none; }
  .screenshot-dark  { display: block; }

  :root[data-theme="light"] .screenshot-light { display: block; }
  :root[data-theme="light"] .screenshot-dark  { display: none; }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]):not([data-theme="light"]) .screenshot-light { display: block; }
    :root:not([data-theme="dark"]):not([data-theme="light"]) .screenshot-dark  { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const sun = document.getElementById('icon-sun')!;
  const moon = document.getElementById('icon-moon')!;

  const saved = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  let isDark = saved ? saved === 'dark' : prefersDark;

  function apply(dark: boolean) {
    root.setAttribute('data-theme', dark ? 'dark' : 'light');
    sun.classList.toggle('hidden', !dark);
    moon.classList.toggle('hidden', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  }

  apply(isDark);

  btn.addEventListener('click', () => {
    isDark = !isDark;
    apply(isDark);
  });
</script>
